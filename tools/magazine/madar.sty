% خبر مع رمز QR للمصدر
\newtcolorbox{newsbox}[1][blue]{enhanced,breakable,colback=white,colframe=#1!60,boxrule=0.6pt,arc=3mm,left=4mm,right=4mm,top=3mm,bottom=3mm,
  borderline west={3pt}{0pt}{#1},before skip=8pt,after skip=8pt}
\newcommand{\News}[6][blue]{% [color]{field}{title}{text}{source}{url}
  \begin{newsbox}[#1]
  \begin{minipage}[t]{\dimexpr\linewidth-26mm}
   {\sansfont\small\bfseries\color{#1}#2}\par
   {\Large\bfseries #3\par}\vspace{2pt}
   #4\par
   {\sansfont\footnotesize\color{muted}المصدر: \textenglish{#5}}
  \end{minipage}\hfill
  \begin{minipage}[t]{22mm}\centering\vspace{2mm}
   \textenglish{\qrcode[height=20mm]{#6}}\par{\sansfont\scriptsize\color{muted}امسح للمصدر}
  \end{minipage}
  \end{newsbox}}

